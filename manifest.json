{
  "manifest_version": 3,
  "name": "Discord Mini DM",
  "version": "0.13.0",
  "key": "",
  "description": "Compact Discord direct-message layout",
  "content_scripts": [
    {
      "matches": [
        "https://discord.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "開啟 Mini DM"
  },
  "host_permissions": [
    "https://discord.com/*"
  ]
}